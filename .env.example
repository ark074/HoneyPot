###############################################################################
# AegisTrap - Environment Configuration
#
# Copy to .env and customize before deployment:
#   cp .env.example .env
#
# All values shown are defaults. Uncomment and modify as needed.
###############################################################################

# =============================================================================
# LLM Configuration (Ollama)
# =============================================================================
# OLLAMA_HOST=http://ollama-service:11434
# OLLAMA_MODEL=llama3:8b

# =============================================================================
# Service Ports
# =============================================================================
# SSH_PORT=2222
# TELNET_PORT=23
# HTTP_PORT=80
# HTTP_ALT_PORT=8080
# FTP_PORT=21
# DASHBOARD_PORT=9000

# =============================================================================
# Logging
# =============================================================================
# LOG_DIR=/app/logs

# =============================================================================
# GeoIP Databases (MaxMind GeoLite2)
# Download from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# =============================================================================
# GEOIP_CITY_DB=/app/data/geoip/GeoLite2-City.mmdb
# GEOIP_ASN_DB=/app/data/geoip/GeoLite2-ASN.mmdb

# =============================================================================
# YARA Rules Directory
# Place .yar/.yara files here for malware scanning
# =============================================================================
# YARA_RULES_DIR=/app/data/yara_rules

# =============================================================================
# Redis (Caching & Pub/Sub)
# =============================================================================
# REDIS_URL=redis://redis:6379/0

# =============================================================================
# Elasticsearch (Log Storage)
# =============================================================================
# ELASTICSEARCH_URL=http://elasticsearch:9200

# =============================================================================
# Alerting - Slack (Incoming Webhook)
# Create at: https://api.slack.com/messaging/webhooks
# =============================================================================
# ALERT_SLACK_ENABLED=true
# ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
# ALERT_SLACK_MIN_SEVERITY=high

# =============================================================================
# Alerting - Discord (Webhook)
# Create in: Server Settings > Integrations > Webhooks
# =============================================================================
# ALERT_DISCORD_ENABLED=false
# ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...
# ALERT_DISCORD_MIN_SEVERITY=high

# =============================================================================
# Alerting - Telegram (Bot API)
# Create bot via @BotFather, get chat_id via @userinfobot
# =============================================================================
# ALERT_TELEGRAM_ENABLED=false
# ALERT_TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# ALERT_TELEGRAM_CHAT_ID=-1001234567890
# ALERT_TELEGRAM_MIN_SEVERITY=critical

# =============================================================================
# Alerting - Generic Webhook
# Sends JSON POST to any endpoint on alert events
# =============================================================================
# ALERT_WEBHOOK_ENABLED=false
# ALERT_WEBHOOK_URL=https://your-siem.example.com/api/alerts
# ALERT_WEBHOOK_MIN_SEVERITY=medium

# =============================================================================
# Alerting - Email (SMTP)
# =============================================================================
# ALERT_EMAIL_ENABLED=false
# ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
# ALERT_EMAIL_SMTP_PORT=587
# ALERT_EMAIL_SMTP_USER=alerts@yourdomain.com
# ALERT_EMAIL_SMTP_PASS=app-specific-password
# ALERT_EMAIL_FROM=aegistrap@yourdomain.com
# ALERT_EMAIL_TO=soc-team@yourdomain.com,admin@yourdomain.com
# ALERT_EMAIL_MIN_SEVERITY=critical

# =============================================================================
# Grafana (Dashboard Visualization)
# =============================================================================
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=aegistrap
